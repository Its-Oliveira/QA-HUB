# Copie para .env (ignorado pelo git) para desenvolvimento local.
# Em produção (GitHub Pages) estes valores vêm de GitHub > Settings > Secrets and variables > Actions.
# ATENÇÃO: tudo com prefixo VITE_ vai para o bundle público do navegador.
# Só coloque aqui a chave "anon/publishable" do Supabase. NUNCA service_role, tokens do Jira ou PAT do GitHub.
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-anon-publishable"
VITE_SUPABASE_PROJECT_ID="seu-project-id"
